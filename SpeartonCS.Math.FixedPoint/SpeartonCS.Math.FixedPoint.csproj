<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SpeartonCS.Math.FixedPoint</Title>
    <Authors>SpeartonCS</Authors>
    <Description>Fixed-Point GENERIC math for .NET 10 and higher</Description>
    <PackageTags>net;dotnet;10;net10;dotnet10;.net;.net10;10.0;math;fixed;point;number;integer</PackageTags>
    <IsAotCompatible>True</IsAotCompatible>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Spearton-CS/SpeartonCS.Math.FixedPoint</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Spearton-CS/SpeartonCS.Math.FixedPoint</PackageProjectUrl>

	<VersionPrefix>0.1.0</VersionPrefix>
	<VersionSuffix>beta.1</VersionSuffix>
	<Copyright></Copyright>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
